/* 对标对比页 */
.comparison-summary .card-title {
  display: block;
  margin-bottom: 24rpx;
}

.summary-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 16rpx 0;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d6cdf;
}

.summary-num.orange { color: #f5a623; }
.summary-num.green  { color: #3c9c3f; }

.summary-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  text-align: center;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e8ecf0;
}

/* 雷达图 */
.radar-card {
  padding: 24rpx;
}

.radar-container {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.radar-canvas {
  display: block;
  margin: 0 auto;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding-top: 12rpx;
  padding-bottom: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-dot.blue   { background: #2d6cdf; }
.legend-dot.orange { background: #f5a623; }

.legend-dash {
  width: 24rpx;
  height: 0;
  border-top: 3rpx dashed #3c9c3f;
}

/* 柱状对比 */
.bar-card {
  padding: 24rpx;
}

.bar-list {
  margin-top: 20rpx;
}
