<!-- 首页 - 综合概览 -->
<view class="container">

  <!-- 顶部标题栏（含校徽） -->
  <view class="header-card card">
    <view class="header-top">
      <!-- 校徽 -->
      <image class="emblem-img" src="/assets/emblem.png" mode="aspectFill"></image>
      <view class="header-title">
        <text class="school-name">中国民航大学</text>
        <text class="school-en">Civil Aviation University of China</text>
        <text class="sub-title">双一流建设完成度实时报告</text>
      </view>
    </view>
  </view>

  <!-- 综合完成度环形图 -->
  <view class="overview-card card">
    <view class="card-header">
      <text class="card-title">综合完成度</text>
      <text class="card-subtitle">更新: {{updateTime}}</text>
    </view>

    <view class="ring-section">
      <view class="ring-wrapper">
        <canvas class="ring-canvas" canvas-id="overallRing" id="overallRing"></canvas>
        <view class="ring-center">
          <text class="ring-big-num">{{overallRate}}</text>
          <text class="ring-percent-sign">%</text>
          <text class="ring-label">综合完成度</text>
        </view>
      </view>
    </view>

    <view class="rate-explain">
      <view class="explain-item">
        <view class="explain-dot cauc"></view>
        <text>本校达成度</text>
      </view>
      <view class="explain-item">
        <view class="explain-dot target"></view>
        <text>双一流建设目标</text>
      </view>
    </view>
  </view>

  <!-- 五大维度卡片（单列满宽） -->
  <view class="section-title">各维度完成度</view>

  <view class="category-list" wx:if="{{!loading}}">
    <view
      class="category-card-full"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goToCategory"
    >
      <!-- 左侧图标 -->
      <view class="cat-left">
        <view class="cat-icon-lg" style="background: {{item.id === 1 ? '#e8f0fe' : item.id === 2 ? '#fde8e7' : item.id === 3 ? '#e8f5e9' : item.id === 4 ? '#fef5e7' : '#f3eaf8'}};">
          <text style="font-size: 40rpx;">{{item.id === 1 ? '🎓' : item.id === 2 ? '👨‍🏫' : item.id === 3 ? '🔬' : item.id === 4 ? '🤝' : '🌍'}}</text>
        </view>
      </view>

      <!-- 右侧内容 -->
      <view class="cat-right">
        <view class="cat-top-row">
          <text class="cat-name-lg">{{item.name}}</text>
          <text class="cat-rate-lg" style="color: {{item.rate >= 70 ? '#2ecc71' : item.rate >= 50 ? '#3498db' : item.rate >= 30 ? '#f39c12' : '#e74c3c'}};">{{item.rate}}%</text>
        </view>

        <!-- 进度条 -->
        <view class="progress-bar cat-progress">
          <view
            class="progress-bar-fill"
            style="width: {{item.rate}}%; background: {{item.rate >= 70 ? '#2ecc71' : item.rate >= 50 ? '#3498db' : item.rate >= 30 ? '#f39c12' : '#e74c3c'}};"
          ></view>
        </view>

        <!-- 副信息行 -->
        <view class="cat-bottom-row">
          <text class="cat-sub-info">全国均值达成度 {{item.nationalRate}}%</text>
          <text class="cat-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学校名片横幅 -->
  <view class="school-banner" wx:if="{{!loading}}">
    <text class="school-banner-icon">✈</text>
    <view class="school-banner-text">
      <text class="school-banner-name">中国民航大学</text>
      <text class="school-banner-motto">明德至善  弘毅兴邦</text>
    </view>
    <text class="school-banner-tag">双一流</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-text" wx:if="{{loading}}">加载中...</view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{error && !loading}}">
    <text class="error-icon">!</text>
    <text class="error-title">数据加载失败</text>
    <text class="error-desc">请确认后端 Flask 服务已启动</text>
    <text class="error-hint">cd backend && python app.py</text>
    <button class="btn-retry" bindtap="fetchData">重新加载</button>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-action mt-24">
    <button class="btn-primary" bindtap="goToComparison">
      查看详细对标对比 →
    </button>
  </view>

</view>
