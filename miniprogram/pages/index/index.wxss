/* 首页样式 */
.header-card {
  background: linear-gradient(135deg, #1a3a5c 0%, #2d5f8a 50%, #1a5276 100%);
  color: #fff;
  text-align: center;
  padding: 36rpx 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

/* 校徽图片 */
.emblem-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid rgba(255,255,255,0.3);
  object-fit: cover;
}

.header-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.school-en {
  font-size: 20rpx;
  opacity: 0.65;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
}

.school-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.sub-title {
  font-size: 26rpx;
  opacity: 0.85;
  letter-spacing: 2rpx;
}

/* 综合完成度 */
.overview-card {
  text-align: center;
}

.ring-section {
  display: flex;
  justify-content: center;
  padding: 40rpx 0 20rpx;
}

.ring-wrapper {
  position: relative;
  width: 340rpx;
  height: 340rpx;
}

.ring-canvas {
  width: 340rpx;
  height: 340rpx;
}

.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.ring-big-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #1a3a5c;
  line-height: 1;
}

.ring-percent-sign {
  font-size: 36rpx;
  color: #1a3a5c;
  font-weight: 600;
}

.ring-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.rate-explain {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 10rpx;
  padding-bottom: 10rpx;
}

.explain-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.explain-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.explain-dot.cauc   { background: #2d6cdf; }
.explain-dot.target { background: #3c9c3f; }

/* 五大维度 — 单列满宽卡片 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin: 24rpx 0 18rpx 8rpx;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.category-card-full {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  gap: 22rpx;
}

.cat-left {
  flex-shrink: 0;
}

.cat-icon-lg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-right {
  flex: 1;
  min-width: 0;
}

.cat-top-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cat-name-lg {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.cat-rate-lg {
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.cat-progress {
  margin-bottom: 8rpx;
}

.cat-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-sub-info {
  font-size: 22rpx;
  color: #999;
}

.cat-arrow {
  font-size: 24rpx;
  color: #ccc;
}

/* 学校名片横幅 */
.school-banner {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  background: linear-gradient(135deg, #f0f5fc, #e8eef8);
  border-radius: 16rpx;
  gap: 20rpx;
}

.school-banner-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.school-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.school-banner-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a3a5c;
}

.school-banner-motto {
  font-size: 22rpx;
  color: #5a7a9a;
  letter-spacing: 2rpx;
}

.school-banner-tag {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #1a3a5c, #2d6cdf);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

.bottom-action {
  padding: 20rpx 0 40rpx;
}

.bottom-action button {
  margin: 0;
}
